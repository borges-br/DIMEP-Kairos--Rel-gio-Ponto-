# Stack Portainer / Docker do RDO
#
# IDENTIDADE DA INSTANCIA. Cada empresa/dominio e uma stack separada e estes
# tres valores TEM de ser diferentes entre elas. STACK_NAME da escopo aos
# volumes: repetir o valor faz dois Postgres montarem o mesmo dado.
STACK_NAME=rdo-interproject
WEB_NETWORK_ALIAS=rdo_interproject_web
WEB_IMAGE=ghcr.io/borges-br/rdo-webapp

POSTGRES_DB=rdo
POSTGRES_USER=rdo_admin
POSTGRES_PASSWORD=troque-por-uma-senha-administrativa-longa
POSTGRES_RUNTIME_USER=rdo_app
POSTGRES_RUNTIME_PASSWORD=troque-por-outra-senha-longa
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Tenant piloto GLB Tech. Gere um UUID v4 e mantenha o mesmo valor após a implantação.
APP_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
ORGANIZATION_LEGAL_NAME=GLB Tech
ORGANIZATION_TRADE_NAME=GLB Tech
ORGANIZATION_CNPJ=
APP_BASE_URL=https://rdo.interproject.com.br
AUTH_COOKIE_NAME=__Host-rdo_session
SESSION_TTL_HOURS=8
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
# Tag da imagem no GHCR publicada pelo workflow. Use a versao exata em
# producao; `latest` so em ambiente de teste.
DEPLOYMENT_VERSION=0.0.1

# Primeiro administrador. Usado somente com o profile admin.
ADMIN_NAME=Administrador GLB Tech
ADMIN_EMAIL=admin@glbtech.com.br
ADMIN_PASSWORD=troque-por-uma-senha-com-16-ou-mais-caracteres
ADMIN_ROLES=admin,director

# IMUV - secrets apenas no backend
IMUV_API_BASE_URL=https://api.exemplo-imuv.com
IMUV_API_TOKEN=
IMUV_TENANT=
IMUV_PROJECTS_PATH=/project
IMUV_TASKS_PATH=/task
IMUV_PEOPLE_PATH=/people
IMUV_COLLABORATORS_PATH=/collaborator
IMUV_PROJECT_IDENTIFIER_FIELD=code
IMUV_TASK_IDENTIFIER_FIELD=code
# Trava do envio de frentes ao IMUV. So "true" habilita; qualquer outro valor,
# ou a ausencia da variavel, mantem a publicacao desligada. O IMUV esta em
# producao: ligue apenas depois de validar o POST /task em um projeto de teste.
IMUV_ALLOW_TASK_PUBLISH=false
IMUV_WEBHOOK_SECRET=
IMUV_TIMEOUT_MS=15000

# DIMEP Kairos - preencher depois da homologação do tenant
DIMEP_API_BASE_URL=https://www.dimepkairos.com.br
DIMEP_API_TOKEN=
DIMEP_API_CLIENT_ID=
DIMEP_API_CLIENT_SECRET=
DIMEP_API_USERNAME=
DIMEP_API_PASSWORD=
DIMEP_TENANT=
DIMEP_MARKS_PATH=RestServiceApi/Appointment/GetAppointmentsPointer
DIMEP_EMPLOYEES_PATH=RestServiceApi/People/SearchPeople
DIMEP_POINTER_ACK_PATH=RestServiceApi/Appointment/SetAppointmentsPointer
DIMEP_TIMEOUT_MS=15000

# Evidências S3/MinIO
MINIO_ROOT_USER=rdo_minio
MINIO_ROOT_PASSWORD=troque-por-uma-senha-minio-longa
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=rdo-evidencias
# No compose MVP, o webapp herda MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
OBJECT_STORAGE_ACCESS_KEY=rdo_minio
OBJECT_STORAGE_SECRET_KEY=mesmo-valor-de-MINIO_ROOT_PASSWORD
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MEDIA_MAX_FILE_MB=15

# Sincronizacao automatica de apontamentos (DIMEP). "false" desliga o agendador
# neste container; a janela e o intervalo ficam na tabela rdo.sync_schedules.
HOURS_SYNC_SCHEDULER=true
# Idade minima da evidencia orfa removida por scripts/cleanup-orphan-media.mjs
MEDIA_ORPHAN_MAX_AGE_HOURS=48

# Publique apenas o webapp. O PostgreSQL permanece na rede interna.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
